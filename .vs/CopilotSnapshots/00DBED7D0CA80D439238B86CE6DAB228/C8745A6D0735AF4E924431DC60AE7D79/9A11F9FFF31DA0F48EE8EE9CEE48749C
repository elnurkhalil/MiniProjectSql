using ConpanyApp.Domain.Entities;
using ConpanyApp.Repository.Data;
using ConpanyApp.Repository.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using ConpanyApp.Service.Exceptions;
using ConpanyApp.Service.Helpers.Constants;

namespace ConpanyApp.Repository.Repositories
{
    public class BaseRepository<T> : IBaseRepository<T> where T : BaseEntity
    {
        public List<T> GetAll()
        {
            if (typeof(T) == typeof(Department))
                return AppDbContext.Departments.Cast<T>().ToList();

            if (typeof(T) == typeof(Employee))
                return AppDbContext.Employees.Cast<T>().ToList();

            return new List<T>();
        }

        
        public T GetById(int id)
        {
            if (id <= 0)
                throw new ValidationException(Messages.IdMustBeGreaterThanZero);

            var entity = GetAll().FirstOrDefault(e => e.Id == id);
            if (entity == null)
                throw new NotFoundException(string.Format(Messages.EntityNotFound, typeof(T).Name, id));

            return entity;
        }

        public void Create(T entity)
        {
            if (entity == null)
                throw new ValidationException("Entity must not be null.");
            if (entity is Department department)
            {
                if (string.IsNullOrWhiteSpace(department.Name))
                    throw new ValidationException(Messages.DepartmentNameRequired);

                if (department.Capacity < 0)
                    throw new ValidationException(Messages.DepartmentCapacityNonNegative);

                if (department.Id <= 0)
                    department.Id = AppDbContext.GetNextDepartmentId();

                AppDbContext.Departments.Add(department);
                return;
            }

            if (entity is Employee employee)
            {
                if (string.IsNullOrWhiteSpace(employee.Name) || string.IsNullOrWhiteSpace(employee.Surname))
                    throw new ValidationException(Messages.EmployeeNameSurnameRequired);

                if (employee.Name.Any(char.IsDigit) || employee.Surname.Any(char.IsDigit))
                    throw new ValidationException(Messages.EmployeeNameSurnameNoDigits);

                if (employee.Id <= 0)
                    employee.Id = AppDbContext.GetNextEmployeeId();

                AppDbContext.Employees.Add(employee);
                return;
            }

            throw new AppException(string.Format(Messages.OperationNotSupportedForType, typeof(T).Name));
        }

        public void Edit(T entity)
        {
            if (entity == null)
                throw new ValidationException("Entity must not be null.");

            if (entity is Department department)
            {
                if (department.Id <= 0)
                    throw new ValidationException(Messages.IdMustBeGreaterThanZero);

                var existing = AppDbContext.Departments.FirstOrDefault(d => d.Id == department.Id);
                if (existing == null)
                    throw new NotFoundException(string.Format(Messages.DepartmentNotFound, department.Id));

                if (!string.IsNullOrWhiteSpace(department.Name))
                    existing.Name = department.Name;

                if (department.Capacity < 0)
                    throw new ValidationException(Messages.DepartmentCapacityNonNegative);

                if (department.Capacity > 0)
                    existing.Capacity = department.Capacity;
                return;
            }

            if (entity is Employee employee)
            {
                if (string.IsNullOrWhiteSpace(employee.Name) || string.IsNullOrWhiteSpace(employee.Surname))
                    throw new ValidationException(Messages.EmployeeNameSurnameRequired);

                if (employee.Name.Any(char.IsDigit) || employee.Surname.Any(char.IsDigit))
                    throw new ValidationException(Messages.EmployeeNameSurnameNoDigits);

                var existing = AppDbContext.Employees.FirstOrDefault(e => e.Id == employee.Id);
                if (existing == null)
                    throw new NotFoundException(string.Format(Messages.EmployeeNotFound, employee.Id));

                existing.Name = employee.Name;
                existing.Surname = employee.Surname;
                existing.Age = employee.Age;
                existing.Address = employee.Address;
                if (employee.Department != null)
                {
                    var dept = AppDbContext.Departments.FirstOrDefault(d => d.Id == employee.Department.Id);
                    existing.Department = dept ?? employee.Department;
                }

                return;
            }

            throw new AppException(string.Format(Messages.OperationNotSupportedForType, typeof(T).Name));
        }



        public void Delete(int id)
        {
            if (id <= 0)
                throw new ValidationException(Messages.IdMustBeGreaterThanZero);

            if (typeof(T) == typeof(Department))
            {
                var department = AppDbContext.Departments.FirstOrDefault(d => d.Id == id);
                if (department == null)
                    throw new NotFoundException(string.Format(Messages.DepartmentNotFound, id));

                AppDbContext.Departments.Remove(department);
                return;
            }

            if (typeof(T) == typeof(Employee))
            {
                var employee = AppDbContext.Employees.FirstOrDefault(e => e.Id == id);
                if (employee == null)
                    throw new NotFoundException(string.Format(Messages.EmployeeNotFound, id));

                AppDbContext.Employees.Remove(employee);
                return;
            }

            throw new AppException(string.Format(Messages.OperationNotSupportedForType, typeof(T).Name));
        }
    }
}
