using ConpanyApp.Domain.Entities;
using ConpanyApp.Service.Exceptions;
using ConpanyApp.Service.Helpers.Constants;
using ConpanyApp.Repository.Interfaces;
using ConpanyApp.Service.Services.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;

namespace ConpanyApp.Service.Services
{
    public class EmployeeService : IEmployeeService
    {
        private readonly IEmployeeRepository _repository;

        public EmployeeService(IEmployeeRepository repository)
        {
            _repository = repository;
        }

        public Employee GetById(int id)
        {
            if (id <= 0) return null;
            return _repository.GetById(id);
        }

        public void UpdateEmployee(Employee employee)
        {
            if (employee == null) throw new ArgumentNullException(nameof(employee));
            if (string.IsNullOrWhiteSpace(employee.Name)) throw new Exception("Имя не может быть пустым");
            if (employee.Age < 18 || employee.Age > 100) throw new Exception("Недопустимый возраст");

            var existing = _repository.GetById(employee.Id);
            if (existing == null) { 
                throw new Exception($"Сотрудник с ID {employee.Id} не найден");
            }

            _repository.Edit(employee);
        }

        public List<Employee> GetEmployeesByAge(int age)
        {
            if (age <= 0) return new List<Employee>();

            return _repository.GetByAge(age);
        }

        public List<Employee> GetEmployeesByDepartment(int departmentId)
        {
            if (departmentId <= 0) return new List<Employee>();

            return _repository.GetByDepartmentId(departmentId);
        }

        public List<Employee> GetEmployeesByDepartmentName(string name)
        {
            if (string.IsNullOrWhiteSpace(name)) return new List<Employee>();

            return _repository.GetByDepartmentName(name.Trim());
        }

        public List<Employee> Search(string text)
        {
            if (string.IsNullOrWhiteSpace(text)) return new List<Employee>();

            string cleanText = text.Trim();

            return _repository.SearchByNameOrSurname(cleanText);
        }

        public int GetTotalCount()
        {
            return _repository.GetEmployeeCount();
        }
    }
}