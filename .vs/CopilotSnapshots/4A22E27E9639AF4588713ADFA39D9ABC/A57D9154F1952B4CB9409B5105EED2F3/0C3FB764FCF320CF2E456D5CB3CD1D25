using CompanyApp.Domain.Entities;
using CompanyApp.Domain.Enums;
using CompanyApp.Repository.Data;
using CompanyApp.Repository.Interfaces;
using System;
using System.Collections.Generic;
using System.Linq;

namespace CompanyApp.Repository.Repositories
{
    public class DepartmentRepository : BaseRepository<Department>, IDepartmentRepository
    {
        protected override List<Department> GetSource() => AppDbContext.Departments;

        public override void Edit(Department entity)
        {
            var existing = GetById(entity.Id);
            if (existing != null)
            {
                existing.Name = entity.Name;
                existing.Capacity = entity.Capacity;
            }
        }

        public List<Department> SearchByName(string text)
        {
            return GetSource()
                .Where(d => d.Name != null && d.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        public List<Department> GetSortedByCapacity(SortDirection direction)
        {
            var query = GetSource().AsQueryable();
            if (direction == SortDirection.Ascending)
            {
                return query
                    .OrderBy(d => d.Capacity ?? int.MaxValue)
                    .ToList();
            }

            if (direction == SortDirection.Descending)
            {
                return query
                    .OrderByDescending(d => d.Capacity ?? int.MinValue)
                    .ToList();
            }

            return query.ToList();
        }
    }
}
